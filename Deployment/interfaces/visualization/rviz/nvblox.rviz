Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 28; 32; 38
    Fixed Frame: world
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: World grid
      Enabled: true
      Cell Size: 0.5
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: world
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: World axes
      Enabled: true
      Length: 0.5
      Radius: 0.012
      Reference Frame: world
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: nvblox TSDF voxels
      Enabled: true
      Topic:
        Value: /nvblox_node/tsdf_layer_marker
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: VIO path
      Enabled: true
      Topic:
        Value: /okvis/okvis_path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Color: 255; 170; 55
      Line Width: 0.025
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Camera pose
      Enabled: true
      Topic:
        Value: /visualization/camera_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Shape: Axes
      Axes Length: 0.25
      Axes Radius: 0.012
      Value: true
    - Class: rviz_default_plugins/Map
      Name: 2D occupancy slice
      Enabled: true
      Topic:
        Value: /nvblox_node/static_occupancy_grid
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Value: false
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Pitch: 0.65
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: world
Window Geometry:
  Width: 1280
  Height: 800
