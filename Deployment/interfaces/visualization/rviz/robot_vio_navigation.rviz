Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Enabled: true
  Global Options:
    Background Color: 17; 25; 38
    Fixed Frame: odom
    Frame Rate: 10
  Displays:
  - Class: rviz_default_plugins/MarkerArray
    Name: BlueROV2 six thrusters
    Enabled: true
    Value: true
    Topic:
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
      Value: /visualization/robot_model
  - Class: rviz_default_plugins/MarkerArray
    Name: Observed obstacle surfaces
    Enabled: true
    Value: true
    Topic:
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
      Value: /visualization/surface_mesh
  - Class: rviz_default_plugins/Grid
    Name: World grid (0.5 m)
    Enabled: false
    Cell Size: 0.5
    Plane: XY
    Plane Cell Count: 40
    Reference Frame: odom
    Value: false
  - Class: rviz_default_plugins/Axes
    Name: World axes
    Enabled: false
    Length: 0.5
    Radius: 0.012
    Reference Frame: odom
    Value: false
  - Class: rviz_default_plugins/Path
    Name: Actual VIO trajectory
    Enabled: true
    Topic:
      Value: /visualization/trajectory
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
    Value: true
    Color: 228; 235; 244
    Alpha: 1.0
    Line Style: Billboards
    Line Width: 0.015
  - Class: rviz_default_plugins/Pose
    Name: Current robot pose
    Enabled: true
    Topic:
      Value: /vio/robot_pose
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 5
    Shape: Axes
    Axes Length: 0.25
    Axes Radius: 0.012
    Value: true
  - Class: rviz_default_plugins/Axes
    Name: Robot base_link
    Enabled: false
    Length: 0.4
    Radius: 0.015
    Reference Frame: base_link
    Value: false
  - Class: rviz_default_plugins/Path
    Name: Wavestar 3D path
    Enabled: true
    Topic:
      Value: /visualization/planned_path
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
    Value: true
    Line Style: Billboards
    Line Width: 0.025
    Color: 66; 224; 183
    Alpha: 1.0
  - Class: rviz_default_plugins/Pose
    Name: 3D planning goal
    Enabled: true
    Topic:
      Value: /planning/goal_visualization
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
    Value: true
    Shape: Arrow
    Color: 255; 140; 40
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /planning/goal
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.0
      Pitch: 0.6
      Yaw: 0.8
      Focal Point:
        X: 1.0
        Y: 0.0
        Z: 0.0
      Target Frame: odom
Window Geometry:
  Width: 1400
  Height: 820
  X: 0
  Y: 0
