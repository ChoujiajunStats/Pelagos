Panels:
  - Class: rviz_common/Displays
    Name: 显示
  - Class: rviz_common/Views
    Name: 视角
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 28; 32; 38
    Default Light: true
    Fixed Frame: world
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: 世界参考网格（每格半米）
      Enabled: true
      Alpha: 0.35
      Cell Size: 0.5
      Color: 130; 140; 155
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: world
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: 世界坐标轴
      Enabled: true
      Length: 0.5
      Radius: 0.012
      Reference Frame: world
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: 占据地图（绿色）
      Enabled: true
      Topic:
        Value: /mapping/occupied
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
        Filter size: 1
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 75; 220; 130
      Alpha: 1
      Style: Flat Squares
      Size (Pixels): 4
      Size (m): 0.04
      Decay Time: 0
      Selectable: true
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Path
      Name: 近期相机轨迹（橙色）
      Enabled: true
      Topic:
        Value: /trajectory/estimated
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
        Filter size: 10
      Color: 255; 170; 55
      Alpha: 1
      Line Style: Billboards
      Line Width: 0.025
      Buffer Length: 1
      Pose Style: None
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: 当前相机位姿
      Enabled: true
      Topic:
        Value: /visualization/camera_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
        Filter size: 10
      Shape: Axes
      Axes Length: 0.25
      Axes Radius: 0.012
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: 占据单元方块（可选）
      Enabled: false
      Topic:
        Value: /mapping/occupied_cells
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Value: false
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: 环绕地图
      Distance: 8
      Pitch: 0.65
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: world
Window Geometry:
  Width: 1280
  Height: 800
