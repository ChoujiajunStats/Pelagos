def docker(*args, **kwargs):
    return subprocess.run(['docker', *args], **kwargs)


def build_nbv_image(*args):
    log_path=SIM/'build/nbv-build.log'
    log_path.parent.mkdir(parents=True,exist_ok=True)
    print(f'NBV 构建完整日志：{log_path}',flush=True)
    command=['docker','build','--progress=plain',*args]
    with log_path.open('w',encoding='utf-8',buffering=1) as log:
        with subprocess.Popen(command,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,
                              text=True,encoding='utf-8',errors='replace',bufsize=1) as process:
            try:
                for line in process.stdout:
                    log.write(line);print(line,end='',flush=True)
                code=process.wait()
            except KeyboardInterrupt:
                process.terminate()
                try:process.wait(timeout=5)
                except subprocess.TimeoutExpired:process.kill();process.wait()
                raise
    if code:
        raise RuntimeError(f'NBV 构建失败（退出码 {code}），完整错误已保存：{log_path}')


def available_image(name):
    result = docker('image', 'inspect', name, stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL, check=False)
    return result.returncode == 0


def stop_container(name,seconds=10):
    result=docker('stop','-t',str(seconds),name,capture_output=True,text=True,check=False)
    if result.returncode==0:return True
    if 'No such container' in result.stderr or 'No such object' in result.stderr:return False
    raise RuntimeError(result.stderr.strip() or f'无法停止容器 {name}')


def verify_mapping_image():
    # Read the installed executable directly; a cancelled build can leave the
    # older valid image tag in place, so image existence alone is insufficient.
    result=docker('run','--rm','--network','none','--entrypoint','/usr/bin/test',
                  IMAGE,'-x',MAPPER,capture_output=True,text=True,check=False)
    if result.returncode:
        if result.stderr.strip():raise RuntimeError(result.stderr.strip())
        raise RuntimeError('当前镜像仍是未包含 Wavemap 的旧版，构建可能被取消或失败。'
                           '请执行 ./Simulation/sim build && ./Simulation/sim run')


def nbv_fingerprint():
    digest=hashlib.sha256()
    paths=[*(SIM/'nbv').rglob('*'),*(ROOT/'TP/Planner/nbvplanner').rglob('*'),SIM/'docker/nbv.Dockerfile']
    for path in sorted(p for p in paths if p.is_file() and p.suffix!='.pyc' and '__pycache__' not in p.parts):
        digest.update(str(path.relative_to(ROOT)).encode()+b'\0'+path.read_bytes())
    return digest.hexdigest()


def verify_planner_image():
    result=docker('image','inspect',NBV_IMAGE,'--format',
                  '{{index .Config.Labels "pelagos.nbv.integration-sha256"}}',
                  capture_output=True,text=True,check=True)
    if result.stdout.strip()!=nbv_fingerprint():
        raise RuntimeError('NBV 镜像未包含当前原版适配；请执行 ./Simulation/sim build --planner-only')


def verify_workspace():
    required = ['simulations/uw_simulations/m2_scene.py', 'robot/config/bluerov2_six_disaware.yaml',
                'interfaces/package.xml', 'docker/fastdds.xml']
    missing = [str(STONEFISH / item) for item in required if not (STONEFISH / item).is_file()]
    if missing:
        raise RuntimeError('Stonefish 工作区缺少文件：' + ', '.join(missing))


def doctor():
    checks = []
    checks.append(('Stonefish 工作区', STONEFISH.is_dir(), str(STONEFISH)))
    checks.append(('Porth 资产', (PORTH / 'asset.json').is_file(), str(PORTH)))
    checks.append(('显示环境', bool(os.environ.get('DISPLAY')), os.environ.get('DISPLAY', '未设置')))
    checks.append(('xauth', bool(shutil.which('xauth')), shutil.which('xauth') or '未找到'))
    try:
        result = docker('info', '--format', '{{.ServerVersion}}', capture_output=True, text=True, timeout=15)
        detail = result.stdout if result.returncode == 0 else result.stderr
        checks.append(('Docker 服务', result.returncode == 0, detail.strip() or '无法连接 Docker daemon'))
        if result.returncode == 0:
            checks.append(('仿真基础镜像', available_image(BASE), BASE))
            checks.append(('Pelagos 仿真镜像', available_image(IMAGE), IMAGE))
    except (OSError, subprocess.TimeoutExpired) as exc:
        checks.append(('Docker 服务', False, str(exc)))
    try:
        gpu = subprocess.run(['nvidia-smi', '--query-gpu=name', '--format=csv,noheader'],
                             capture_output=True, text=True, timeout=15)
        checks.append(('NVIDIA GPU', gpu.returncode == 0, (gpu.stdout or gpu.stderr).strip()))
    except (OSError, subprocess.TimeoutExpired) as exc:
        checks.append(('NVIDIA GPU', False, str(exc)))
    for label, ok, detail in checks:
        print(f'{"OK" if ok else "缺少/不可用"}: {label}: {detail}')
    return 0 if all(ok for _, ok, _ in checks) else 1


def build_nbv():
    import json
    for relative in ('package.xml','CMakeLists.txt','native.cpp','srv/Step.srv'):
        path=SIM/'nbv'/relative
        if not path.is_file():raise RuntimeError(f'NBV 适配包缺少构建文件：{path}')
    if not available_image(NBV_BASE):
        raise RuntimeError(f'缺少 ROS1 编译基础镜像 {NBV_BASE}；可用 PELAGOS_NBV_BASE_IMAGE 指定本机 ROS1 镜像')
    cache = STONEFISH / '.cache/omniplanner/src'
    dependencies = ['catkin_simple', 'eigen_catkin', 'eigen_checks', 'gflags_catkin',
                    'glog_catkin', 'minkindr', 'minkindr_ros']
    for name in dependencies:
        if not (cache / name).is_dir():
            raise RuntimeError(f'缺少本机已有 ROS1 依赖源码：{cache / name}')
    with tempfile.TemporaryDirectory(prefix='pelagos-nbv-build-') as temporary:
        context = Path(temporary)
        sources = context / 'sources'
        ignore = shutil.ignore_patterns('.git', '__pycache__', '*.pyc', 'build')
        shutil.copytree(ROOT / 'TP/Planner/nbvplanner', sources / 'nbvplanner', ignore=ignore)
        lock = json.loads((SIM / 'nbv/source-lock.json').read_text())
        for repository in lock:
            for item in repository['files']:
                path=ROOT/repository['root']/item['path']
                if not path.is_file():continue  # Unused upstream demo assets are not fetched.
                data=path.read_bytes()
                blob=hashlib.sha1(f'blob {len(data)}\0'.encode()+data).hexdigest()
                if blob!=item['git_blob']:raise RuntimeError(f'NBV 源文件与锁定版本不符：{path}')
        # catkin_simple's test fixtures contain a symlink back to the package.
        # Tests are disabled in this build; omit their fixture packages and
        # preserve any remaining links rather than recursively dereferencing.
        dependency_ignore=shutil.ignore_patterns('.git','__pycache__','*.pyc','build','test','tests')
        for name in dependencies:
            shutil.copytree(cache / name, sources / name, ignore=dependency_ignore,symlinks=True)
            hashes = {str(p.relative_to(sources / name)): hashlib.sha256(p.read_bytes()).hexdigest()
                      for p in sorted((sources / name).rglob('*')) if not p.is_symlink() and p.is_file()}
            links = {str(p.relative_to(sources / name)): os.readlink(p)
                     for p in sorted((sources / name).rglob('*')) if p.is_symlink()}
            lock.append(dict(local_dependency=name, sha256=hashes,symlinks=links))
        shutil.copytree(SIM / 'nbv', context / 'integration', ignore=ignore)
        (context / 'source-lock.json').write_text(json.dumps(lock, indent=2))
        build_nbv_image('--build-arg', f'NBV_BASE={NBV_BASE}',
               '--label',f'pelagos.nbv.integration-sha256={nbv_fingerprint()}','-t', NBV_IMAGE,
               '-f', str(SIM / 'docker/nbv.Dockerfile'), str(context))
    print(f'已构建原版 NBVPlanner：{NBV_IMAGE}')


def build(planner_only=False):
    verify_workspace()
    if planner_only:
        build_nbv()
        return
    if not available_image(BASE):
        raise RuntimeError(f'找不到基础镜像 {BASE} 或 Docker daemon 不可访问。请先检查 ./Simulation/sim doctor')
    with tempfile.TemporaryDirectory(prefix='pelagos-sim-build-') as temporary:
        context = Path(temporary)
        shutil.copytree(ROOT / 'TP/Localization/okvis2', context / 'okvis2',
                        ignore=shutil.ignore_patterns('.git', '__pycache__', '*.pyc', 'build'))
        shutil.copytree(STONEFISH / 'interfaces', context / 'uw_interfaces',
                        ignore=shutil.ignore_patterns('__pycache__', '*.pyc'))
        shutil.copytree(SIM / 'patches', context / 'patches')
        shutil.copytree(ROOT / 'TP/Stereo/LiteAnyStereoV2/core', context / 'las2_core',
                        ignore=shutil.ignore_patterns('__pycache__', '*.pyc'))
        shutil.copytree(ROOT / 'TP/Mapping/wavemap/library/cpp', context / 'wavemap/library/cpp',
                        ignore=shutil.ignore_patterns('.git','build','__pycache__'))
        shutil.copy2(ROOT / 'TP/Mapping/wavemap/LICENSE', context / 'wavemap/LICENSE')
        shutil.copytree(ROOT / 'Deployment/infrastructure/ros2_ws/src/underwater_wavemap_ros',
                        context / 'underwater_wavemap_ros')
        shutil.copytree(SIM/'rviz_panel',context/'rviz_panel')
        print('开始增量构建；Wavemap 首次编译需要等待，下面会直接显示编译进度。',flush=True)
        docker('build', '--progress=plain', '--build-arg', f'BASE_IMAGE={BASE}', '-t', IMAGE,
               '-f', str(SIM / 'docker/Dockerfile'), str(context), check=True)
    print(f'已构建 {IMAGE}')
    # Build the independent ROS1 NBV image only with --planner-only.


def run(args):
    if args.planning_only:args.manual=False
    verify_workspace()
    if not available_image(IMAGE):
        raise RuntimeError(f'找不到镜像 {IMAGE} 或 Docker daemon 不可访问；先执行 ./Simulation/sim build')
    verify_mapping_image()
    if not args.manual and not available_image(NBV_IMAGE):
        raise RuntimeError(f'缺少原版 NBVPlanner 镜像 {NBV_IMAGE}；执行 ./Simulation/sim build --planner-only')
    if not args.manual:verify_planner_image()
    if args.scene == 'porth' and not (PORTH / 'asset.json').is_file():
        raise RuntimeError(f'Porth 资产不可用：{PORTH}')
    display = os.environ.get('DISPLAY')
    if not display:
        raise RuntimeError('未设置 DISPLAY，请在桌面会话中启动')
    sys.path.insert(0, str(STONEFISH / 'tools'))
    from uw_workspace.environment import prepare_xauth
    run_id = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + uuid.uuid4().hex[:8]
    runs = SIM / 'runs'
    output = runs / run_id
    output.mkdir(parents=True, exist_ok=False)
    container_run = '/runs/' + run_id
    print(f'运行目录：{output}', flush=True)
    with tempfile.TemporaryDirectory(prefix='pelagos-xauth-') as temporary:
        xauth = prepare_xauth(temporary)
        cmd = ['run', '--rm', '--init', '--name', CONTAINER, '--network', 'none',
               '--gpus', 'all', '--shm-size', '1g', '--user', f'{os.getuid()}:{os.getgid()}',
               '--entrypoint', '/bin/bash',
               '-e', f'DISPLAY={display}', '-e', 'XAUTHORITY=/tmp/pelagos.Xauthority',
               '-e', 'NVIDIA_DRIVER_CAPABILITIES=graphics,utility,compute,display',
               '-e', 'QT_X11_NO_MITSHM=1', '-e', f'ROS_DOMAIN_ID={args.ros_domain}',
               '-e', 'RMW_IMPLEMENTATION=rmw_fastrtps_cpp',
               '-e', 'FASTRTPS_DEFAULT_PROFILES_FILE=/stonefish-workspace/docker/fastdds.xml',
               '-e', f'PELAGOS_RUN={container_run}', '-e', f'PELAGOS_SCENE={args.scene}',
               '-e', f'PELAGOS_AUTONOMY={0 if args.manual else 1}',
               '-e', f'PELAGOS_PLANNING_ONLY={1 if args.planning_only else 0}',
               '-e', f'HOME={container_run}',
               '-v', f'{ROOT}:/pelagos:ro', '-v', f'{STONEFISH}:/stonefish-workspace:ro',
               '-v', f'{runs}:/runs', '-v', '/tmp/.X11-unix:/tmp/.X11-unix:ro',
               '-v', f'{xauth}:/tmp/pelagos.Xauthority:ro']
        if args.scene == 'porth':
            cmd.extend(['-v', f'{PORTH}:/porth:ro'])
        cmd.extend([IMAGE, '/pelagos/Simulation/docker/run.sh'])
        planner_started = False
        try:
            if not args.manual:
                docker('run', '-d', '--rm', '--init', '--name', NBV_CONTAINER,
                       '--network', 'none', '--user', f'{os.getuid()}:{os.getgid()}',
                       '--entrypoint', '/bin/bash', '-e', f'PELAGOS_RUN={container_run}',
                       '-e', f'HOME={container_run}', '-v', f'{ROOT}:/pelagos:ro',
                       '-v', f'{runs}:/runs', NBV_IMAGE, '/pelagos/Simulation/docker/nbv.sh',
                       check=True, stdout=subprocess.DEVNULL)
                planner_started = True
            return docker(*cmd, check=False).returncode
        except KeyboardInterrupt:
            docker('stop', '-t', '10', CONTAINER, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return 130
        finally:
            if planner_started:
                docker('stop', '-t', '8', NBV_CONTAINER, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='action', required=True)
    commands.add_parser('doctor')
    builder = commands.add_parser('build')
    builder.add_argument('--planner-only', action='store_true')
    start = commands.add_parser('run')
    start.add_argument('--scene', choices=('fixture', 'porth'), default='porth')
    start.add_argument('--ros-domain', type=int, default=42, choices=range(0, 233), metavar='0..232')
    start.add_argument('--planning-only',action='store_true',help='只建图并测试原版 NBV 轨迹；不启动 Guard、控制器、导航跟踪或推进器适配器')
    mode=start.add_mutually_exclusive_group()
    mode.add_argument('--manual',dest='manual',action='store_true',default=True,help='保留现有手柄手动模式（默认）')
    mode.add_argument('--autonomy',dest='manual',action='store_false',help='原版 NBVPlanner + JEPA-MPPI；用 explore 开始')
    commands.add_parser('status')
    commands.add_parser('stop')
    commands.add_parser('metrics')
    commands.add_parser('map-save',help='保存当前 Wavemap 到本次运行目录的 map.wvmp')
    commands.add_parser('mapping',help='查看 Wavemap 融合、耗时和地图统计')
    commands.add_parser('planner',help='查看 NBV / JEPA / 控制链路状态')
    commands.add_parser('ui',help='Compatibility alias for the native RViz toolbar; no separate UI')
    commands.add_parser('rviz',help='Open RViz with native Explore / Preview / Manual / Auto / Pause tools')
    navigate=commands.add_parser('navigate',help='执行任务面板保存的本次会话路线')
    navigate.add_argument('--route',type=Path,required=True)
    commands.add_parser('explore',help='持续直行，前方障碍净距约 3 m 时切换 NBV 局部规划')
    commands.add_parser('pause',help='停止探索并撤销控制授权')
    commands.add_parser('manual',help='暂停自主任务并切换到手柄/机体速度 PI 手动接管')
    commands.add_parser('autonomous',help='退出手动接管并选择 JEPA-MPPI 自主任务；不自动开始运动')
    commands.add_parser('plan-preview',help='从真实估计地图请求原版 NBV 路径，只显示保存，不执行')
    commands.add_parser('start-preview',help='预览向前起步段；仅豁免固定初始车体体积内未知，不执行')
    commands.add_parser('explore-forward',help='持续直行并同步建图，约 3 m 遇障后局部规划；执行使用 JEPA')
    joystick = commands.add_parser('joystick', help='使用本机手柄控制正在运行的仿真，无需重建或重启')
    joystick.add_argument('--device', default='/dev/input/js0')
    joystick.add_argument('--list', action='store_true', help='列出手柄')
    joystick.add_argument('--inspect', action='store_true', help='只显示按键与摇杆，不连接仿真')
    joystick.add_argument('--deadzone', type=float, default=.12)
    move = commands.add_parser('move', help='仿真中执行有限速度命令，并自动停止')
    move.add_argument('--velocity', nargs=4, type=float, required=True,
                      metavar=('X', 'Y', 'Z', 'YAW'))
    move.add_argument('--seconds', type=float, default=5.0)
    args = parser.parse_args()
    if args.action == 'joystick':
        sys.path.insert(0, str(SIM / 'tools'))
        from joystick_host import main as joystick_main
        return joystick_main(args.device, args.list, args.inspect, args.deadzone, CONTAINER)
    if args.action == 'doctor':
        return doctor()
    if args.action == 'build':
        build(args.planner_only)
        return 0
    if args.action == 'run':
        return run(args)
    if args.action == 'stop':
        stopped=stop_container(CONTAINER)
        stop_container(NBV_CONTAINER,8)
        print('仿真已停止。' if stopped else '仿真当前未运行。')
        return 0
    if args.action=='navigate':
        return docker('exec','-i',CONTAINER,'/bin/bash','/pelagos/Simulation/docker/command.sh',
                      'navigate',input=args.route.read_text(),text=True,check=False).returncode
    if args.action == 'ui':
        print('The separate task UI was removed. Opening the native RViz toolbar.')
        args.action = 'rviz'
    command = ['exec', CONTAINER, '/bin/bash', '/pelagos/Simulation/docker/command.sh']
    if args.action == 'move':
        command.extend(['arm', '--velocity', *(str(v) for v in args.velocity),
                        '--seconds', str(args.seconds)])
    else:
        command.append(args.action)
    return docker(*command, check=False).returncode


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        message=('构建已取消；请等下一次 build 成功后再启动仿真。'
                 if sys.argv[1:2]==['build'] else '操作已取消。')
        print(message,file=sys.stderr)
        raise SystemExit(130)
    except (RuntimeError, OSError, subprocess.CalledProcessError) as exc:
        print(f'错误：{exc}', file=sys.stderr)
        raise SystemExit(1)
