+def sensor_freshness_error(samples,now_ns,clock_ns):
+    """Validate actual incoming sample ages, independently of health-report cadence."""
+    if clock_ns is None:return 'clock_missing'
+    for role in ('left','right','imu'):
+        if role not in samples:return 'sensor_'+role+'_missing'
+        stamp,received=samples[role]
+        if not 0<=now_ns-received<=250_000_000:return 'sensor_'+role+'_stale'
+        if not -50_000_000<=clock_ns-stamp<=250_000_000:return 'sensor_'+role+'_stamp'
+    return None
+
