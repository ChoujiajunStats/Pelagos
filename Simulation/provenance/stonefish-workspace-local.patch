+def planner_layout(layout,namespace,*,mapped_area=False,full_map=False):
+    """Add goal input and measured map/path displays for the six-thruster session."""
+    m=layout['Visualization Manager'];ns=namespace
+    m['Global Options']['Fixed Frame']=ns+'/map'
+    m['Global Options']['Background Color']='255; 255; 255'
+    m['Tools'].append({'Class':'rviz_default_plugins/PublishPoint','Single click':True,'Topic':'/'+ns+'/goal_point'})
+    m['Tools'].append({'Class':'rviz_default_plugins/SetGoal','Topic':'/'+ns+'/goal_pose'})
+    for display in m['Displays']:
+        if display.get('Class')=='rviz_default_plugins/Grid':display.update({'Cell Size':.2,'Color':'190; 195; 200'})
+        if display.get('Class')=='rviz_default_plugins/RobotModel':display.update({'Name':'BlueROV2 six thrusters','Alpha':.4})
+        if display.get('Name')=='Mission status':display['Enabled']=False
+    m['Displays'] += [
+        {'Class':'rviz_default_plugins/Path','Name':'OmniPlanner validated path','Enabled':True,'Color':'70; 220; 255',
+         'Topic':{'Value':f'/{ns}/planner/path','Reliability Policy':'Reliable','Durability Policy':'Volatile','Depth':1}},
+        {'Class':'rviz_default_plugins/Marker','Name':'Navigation status','Enabled':True,'Topic':{'Value':f'/{ns}/planner/status_marker','Reliability Policy':'Reliable','Durability Policy':'Volatile','Depth':1}},
+        {'Class':'rviz_default_plugins/Marker','Name':'Validated goal centers (includes start prior)','Enabled':True,'Topic':{'Value':f'/{ns}/planner/reachable_goals','Reliability Policy':'Reliable','Durability Policy':'Volatile','Depth':1}}]
+    if not any(d.get('Topic',{}).get('Value')==f'/{ns}/slam/cloud_map' for d in m['Displays']):m['Displays'].append(
+        {'Class':'rviz_default_plugins/PointCloud2','Name':'RTAB-Map stereo map','Enabled':True,
+         'Topic':{'Value':f'/{ns}/slam/cloud_map','Reliability Policy':'Reliable','Durability Policy':'Volatile','Depth':1},
+         'Style':'Points','Size (Pixels)':3,'Color Transformer':'RGB8','Position Transformer':'XYZ'})
+    m['Views']['Current']={'Class':'rviz_default_plugins/TopDownOrtho','Name':'Top down waypoint selection','Target Frame':ns+'/odom','Scale':180.,'X':0.,'Y':0.,'Angle':0.}
+    if mapped_area:
+        for display in m['Displays']:
+            if full_map and display.get('Name','').startswith('Known Porth'):display['Enabled']=False
+            if display.get('Name')=='Validated goal centers (includes start prior)':display['Enabled']=False
+        m['Displays'] += [
+            {'Class':'rviz_default_plugins/Marker','Name':'Mapped free/occupied depth slice','Enabled':True,
+             'Topic':{'Value':f'/{ns}/planner/map_slice','Reliability Policy':'Reliable','Durability Policy':'Volatile','Depth':1}},
+            {'Class':'rviz_default_plugins/Marker','Name':'Click selection plane (not free-space evidence)','Enabled':True,
+             'Topic':{'Value':f'/{ns}/planner/goal_plane','Reliability Policy':'Reliable','Durability Policy':'Volatile','Depth':1}}]
+        m['Views']['Current'].update({'Name':'Built map and target selection','Scale':5. if full_map else 70.})
+
